# =============================================================================
# Eureka RAG Chatbot — .gitignore
# =============================================================================
# Python virtual environments
.venv/
venv/
env/
ENV/
.env.local/
.python-version

# Python caches and compiled files
__pycache__/
*.py[cod]
*$py.class
*.pyd
*.pyo

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
.eggs/

# Test caches and coverage
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover

# ─── SECRET-BEARING FILES ────────────────────────────────────────────────────
# Real environment file — NEVER commit this
.env

# ─── LOGS ────────────────────────────────────────────────────────────────────
# Logs may contain user queries or sensitive operational data
*.log
logs/
log/

# ─── EDITOR & OS ARTIFACTS ───────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ─── LOCAL DATABASE FILES ────────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3

# ─── GENERATED VECTOR STORE ──────────────────────────────────────────────────
# Populated local vector indexes — rebuild from chunk JSON via build_index.py
# The directory itself is kept via .gitkeep; populated contents are excluded.
data/vectorstore/*
!data/vectorstore/.gitkeep

# ─── GENERATED CRAWL DATASETS & REPORTS ─────────────────────────────────────
# Actual crawl outputs — generated by running the crawler pipeline
data/raw/*
!data/raw/.gitkeep

data/processed/*
!data/processed/.gitkeep

data/reports/*
!data/reports/.gitkeep

data/checkpoints/*
!data/checkpoints/.gitkeep

# ─── TEMPORARY FILES ─────────────────────────────────────────────────────────
*.tmp
*.temp
*.bak
*.orig
.cache/

# ─── ZIP ARTIFACTS ───────────────────────────────────────────────────────────
# Handoff packages — generated, not source-controlled
eureka-rag-data.zip

# ─── Jupyter (future phases) ─────────────────────────────────────────────────
.ipynb_checkpoints/

# ─── Node (future frontend) ──────────────────────────────────────────────────
node_modules/
.next/
out/

# =============================================================================
# NOT IGNORED (explicitly safe):
# .env.example       — placeholders only, no secrets
# crawler/           — source code
# backend/           — source code
# docs/              — documentation
# tests/             — test source
# frontend-integration/ — integration docs
# requirements*.txt  — dependency manifests
# data/**/.gitkeep   — directory stubs
# =============================================================================
