{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "https://eurekachatbot.onrender.com/api/:match*"
    },
    {
      "source": "/health/:match*",
      "destination": "https://eurekachatbot.onrender.com/health/:match*"
    }
  ]
}
