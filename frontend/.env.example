# =============================================================================
# Eureka RAG Chatbot — Frontend Environment Variables
# =============================================================================

# Base URL for the FastAPI Backend (No trailing slash)
VITE_EUREKA_API_BASE_URL=http://127.0.0.1:8000

# Set to true to force client-side mock fixtures during offline development/testing
VITE_MOCK_API=false

# Optional request timeout in milliseconds (default: 30000)
VITE_REQUEST_TIMEOUT_MS=30000
