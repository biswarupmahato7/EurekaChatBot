# =============================================================================
# Eureka RAG Chatbot — Environment Configuration Template
# =============================================================================
#
# INSTRUCTIONS:
#   1. Copy this file:   cp .env.example .env      (Linux/macOS)
#                        copy .env.example .env    (Windows)
#   2. Fill in real values in .env
#   3. NEVER commit .env to Git — it is protected by .gitignore
#   4. This file (.env.example) contains only safe placeholders and
#      must remain in version control.
#
# =============================================================================

# ─── Application ─────────────────────────────────────────────────────────────
# Environment mode: development | staging | production
APP_ENV=development

# Backend host and port (Phase C onwards)
APP_HOST=0.0.0.0
APP_PORT=8000

# API version prefix
API_BASE_PATH=/api/v1

# Allowed CORS origins — comma-separated, no trailing slashes
# Example: http://localhost:3000,https://eurekasolutions.in
ALLOWED_ORIGINS=http://localhost:3000,https://eurekasolutions.in

# ─── Logging ─────────────────────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ─── Crawler (Phase A) ───────────────────────────────────────────────────────
# Descriptive User-Agent for the crawler (include project contact if appropriate)
CRAWLER_USER_AGENT=EurekaRAGBot/1.0 (contact: your-email@example.com)

# HTTP request timeout in seconds
CRAWLER_REQUEST_TIMEOUT_SECONDS=30

# Delay between requests in seconds (respect the target server)
CRAWLER_REQUEST_DELAY_SECONDS=1.0

# Maximum number of pages to crawl per run
CRAWLER_MAX_PAGES=200

# Maximum crawl depth from the start URL
CRAWLER_MAX_DEPTH=5

# Number of retry attempts on transient HTTP errors
CRAWLER_MAX_RETRIES=3

# Maximum response body size in bytes (5 MB default)
CRAWLER_MAX_RESPONSE_BYTES=5242880

# Maximum number of concurrent requests (keep low to respect the server)
CRAWLER_CONCURRENCY=1

# ─── Data paths ──────────────────────────────────────────────────────────────
# Paths are relative to the project root unless absolute paths are provided.
RAW_DATA_PATH=./data/raw/eureka_website_data.json
PROCESSED_DATA_PATH=./data/processed/eureka_website_chunks.json
REPORTS_PATH=./data/reports
CHECKPOINTS_PATH=./data/checkpoints

# ─── Chunking / Tokenizer ────────────────────────────────────────────────────
# Tokenizer used for token counting during chunking.
# IMPORTANT: The same tokenizer MUST be used consistently for both chunking
# and any downstream validation. Token counts are tokenizer-dependent and
# will vary between tiktoken encodings and other tokenizers.
# Default: cl100k_base (tiktoken encoding compatible with OpenAI-family models).
TOKENIZER=cl100k_base

# Chunking parameters (tune after retrieval evaluation in Phase B/E)
CHUNK_TARGET_TOKENS=500
CHUNK_OVERLAP_TOKENS=75
CHUNK_MAX_TOKENS=700
CHUNK_MIN_TOKENS=80

# ─── Vector store (Phase B onwards) ──────────────────────────────────────────
VECTOR_STORE=chroma
CHROMA_PERSIST_DIRECTORY=./data/vectorstore
CHROMA_COLLECTION=eureka_website_chunks

# ─── Embedding model (Phase B onwards) ───────────────────────────────────────
# The embedding model name and version must be treated as configuration values.
# If a different embedding model is chosen, rebuild the ENTIRE index from scratch.
# Never mix chunks/queries embedded with different models.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ─── Retrieval settings (Phase B/C — tune on golden set) ─────────────────────
TOP_K=6
# Set this only after measuring Chroma distance semantics; scores are NOT probabilities.
RELEVANCE_THRESHOLD=configure_after_evaluation

# ─── Groq LLM (Phase C onwards — backend only) ───────────────────────────────
# SECURITY: GROQ_API_KEY must NEVER appear in:
#   - Frontend/client-side code or environment variables
#   - Git history or any committed files
#   - Application logs, error responses, or the handoff ZIP
# Verify the model ID from current Groq docs at deployment time:
#   https://console.groq.com/docs/models
GROQ_API_KEY=replace_with_secret
GROQ_MODEL=replace_with_current_supported_model_id
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_RETRIES=2

# ─── API limits (Phase C onwards) ────────────────────────────────────────────
# Maximum allowed message length in characters
MAX_MESSAGE_CHARACTERS=2000

# Rate limit: configure based on expected host capacity and provider quotas
RATE_LIMIT_PER_MINUTE=configure_for_host
